  ],
  "externalTargets": [
    {
      "name": "외부 테스트 예시",
      "url": "https://example.invalid/network-test/100mb.bin",
      "requireProxy": true,
      "allowedRedirectHosts": [
        "cdn.example.invalid"
      ]
    }
  ]
}
