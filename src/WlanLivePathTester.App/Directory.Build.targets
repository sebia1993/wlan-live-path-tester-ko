    <None Include="$(MSBuildThisFileDirectory)..\..\docs\OBSERVATION_TIMING_CONTINUITY.md" Link="docs\OBSERVATION_TIMING_CONTINUITY.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\OBSERVATION_REPORT_PIPELINE_E2E.md" Link="docs\OBSERVATION_REPORT_PIPELINE_E2E.md" CopyToPublishDirectory="PreserveNewest" />
