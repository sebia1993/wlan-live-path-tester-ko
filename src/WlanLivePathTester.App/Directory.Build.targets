    <None Include="$(MSBuildThisFileDirectory)..\..\docs\OBSERVATION_COUNTER_RESET_FINDING.md" Link="docs\OBSERVATION_COUNTER_RESET_FINDING.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\OBSERVATION_POWER_TRANSITIONS.md" Link="docs\OBSERVATION_POWER_TRANSITIONS.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\OBSERVATION_COMBINED_DISRUPTIONS.md" Link="docs\OBSERVATION_COMBINED_DISRUPTIONS.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\WLAN_IDENTITY_CONTINUITY.md" Link="docs\WLAN_IDENTITY_CONTINUITY.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\RELEASE_NOTES_0.1.0-alpha.10.md" Link="docs\RELEASE_NOTES_0.1.0-alpha.10.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\INTERNAL_PROXY_ROUTE_COMPARISON_COORDINATOR_V2.md" Link="docs\INTERNAL_PROXY_ROUTE_COMPARISON_COORDINATOR_V2.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\INTERNAL_PROXY_ROUTE_COMPARISON_RUN_FINDINGS_V2.md" Link="docs\INTERNAL_PROXY_ROUTE_COMPARISON_RUN_FINDINGS_V2.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\INTERNAL_PROXY_ROUTE_COMPARISON_UI_V3.md" Link="docs\INTERNAL_PROXY_ROUTE_COMPARISON_UI_V3.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\WINDOWS_ROUTE_PROXY_IMPORT.md" Link="docs\WINDOWS_ROUTE_PROXY_IMPORT.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\ROUTE_COMPARISON_REPORT_EXPORT.md" Link="docs\ROUTE_COMPARISON_REPORT_EXPORT.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateObservationGuidesInPublish" AfterTargets="Publish">
    <Error Condition="!Exists('$(PublishDir)docs\STRUCTURED_OBSERVATION_TERMINATION.md')" Text="Published output is missing STRUCTURED_OBSERVATION_TERMINATION.md." />
    <Error Condition="!Exists('$(PublishDir)docs\UNIFIED_OBSERVATION_TERMINATION_REPORTING.md')" Text="Published output is missing UNIFIED_OBSERVATION_TERMINATION_REPORTING.md." />
    <Error Condition="!Exists('$(PublishDir)docs\OBSERVATION_TERMINATION_FINDINGS.md')" Text="Published output is missing OBSERVATION_TERMINATION_FINDINGS.md." />
    <Error Condition="!Exists('$(PublishDir)docs\INJECTABLE_OBSERVATION_RUNTIME.md')" Text="Published output is missing INJECTABLE_OBSERVATION_RUNTIME.md." />
    <Error Condition="!Exists('$(PublishDir)docs\OBSERVATION_TIMING_CONTINUITY.md')" Text="Published output is missing OBSERVATION_TIMING_CONTINUITY.md." />
    <Error Condition="!Exists('$(PublishDir)docs\OBSERVATION_REPORT_PIPELINE_E2E.md')" Text="Published output is missing OBSERVATION_REPORT_PIPELINE_E2E.md." />
    <Error Condition="!Exists('$(PublishDir)docs\OBSERVATION_REPORT_TERMINATION_MATRIX.md')" Text="Published output is missing OBSERVATION_REPORT_TERMINATION_MATRIX.md." />
    <Error Condition="!Exists('$(PublishDir)docs\BROWSER_OBSERVATION_REPORT.md')" Text="Published output is missing BROWSER_OBSERVATION_REPORT.md." />
    <Error Condition="!Exists('$(PublishDir)docs\OBSERVATION_COUNTER_RESET_FINDING.md')" Text="Published output is missing OBSERVATION_COUNTER_RESET_FINDING.md." />
    <Error Condition="!Exists('$(PublishDir)docs\OBSERVATION_COMBINED_DISRUPTIONS.md')" Text="Published output is missing OBSERVATION_COMBINED_DISRUPTIONS.md." />
    <Error Condition="!Exists('$(PublishDir)docs\OBSERVATION_POWER_TRANSITIONS.md')" Text="Published output is missing OBSERVATION_POWER_TRANSITIONS.md." />
    <Error Condition="!Exists('$(PublishDir)docs\WLAN_IDENTITY_CONTINUITY.md')" Text="Published output is missing WLAN_IDENTITY_CONTINUITY.md." />
    <Error Condition="!Exists('$(PublishDir)docs\RELEASE_NOTES_0.1.0-alpha.10.md')" Text="Published output is missing RELEASE_NOTES_0.1.0-alpha.10.md." />
    <Error Condition="!Exists('$(PublishDir)docs\INTERNAL_PROXY_ROUTE_COMPARISON_COORDINATOR_V2.md')" Text="Published output is missing INTERNAL_PROXY_ROUTE_COMPARISON_COORDINATOR_V2.md." />
    <Error Condition="!Exists('$(PublishDir)docs\INTERNAL_PROXY_ROUTE_COMPARISON_RUN_FINDINGS_V2.md')" Text="Published output is missing INTERNAL_PROXY_ROUTE_COMPARISON_RUN_FINDINGS_V2.md." />
    <Error Condition="!Exists('$(PublishDir)docs\INTERNAL_PROXY_ROUTE_COMPARISON_UI_V3.md')" Text="Published output is missing INTERNAL_PROXY_ROUTE_COMPARISON_UI_V3.md." />
    <Error Condition="!Exists('$(PublishDir)docs\WINDOWS_ROUTE_PROXY_IMPORT.md')" Text="Published output is missing WINDOWS_ROUTE_PROXY_IMPORT.md." />
    <Error Condition="!Exists('$(PublishDir)docs\ROUTE_COMPARISON_REPORT_EXPORT.md')" Text="Published output is missing ROUTE_COMPARISON_REPORT_EXPORT.md." />
  </Target>
</Project>
