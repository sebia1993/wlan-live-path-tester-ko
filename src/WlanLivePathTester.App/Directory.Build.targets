<Project>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\STRUCTURED_OBSERVATION_TERMINATION.md" Link="docs\STRUCTURED_OBSERVATION_TERMINATION.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\UNIFIED_OBSERVATION_TERMINATION_REPORTING.md" Link="docs\UNIFIED_OBSERVATION_TERMINATION_REPORTING.md" CopyToPublishDirectory="PreserveNewest" />
