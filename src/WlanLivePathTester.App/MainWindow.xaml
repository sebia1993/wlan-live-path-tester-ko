<Window x:Class="WlanLivePathTester.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WLAN Live Path Tester KO"
        Width="980"
        Height="720"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="#17202A"
                   Text="WLAN Live Path Tester KO" />
        <TextBlock Margin="0,8,0,0"
                   FontSize="14"
                   Foreground="#566573"
                   Text="무선 링크·내부망·회사 프록시 경유 외부망을 분리해 확인하는 로컬 진단 도구" />
      </StackPanel>

      <Border Grid.Row="1"
              Margin="0,22,0,0"
              Padding="16"
              CornerRadius="10"
              Background="#EAF2F8"
              BorderBrush="#5DADE2"
              BorderThickness="1">
        <TextBlock Foreground="#1B4F72"
                   TextWrapping="Wrap">
          현재 버전은 M1 WLAN 상태 수집 단계입니다. 프로그램 시작만으로 외부 통신을 만들지 않으며,
          WLAN과 프록시 확인 버튼도 로컬 Windows API만 사용합니다.
        </TextBlock>
      </Border>

      <Grid Grid.Row="2" Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.35*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="18" CornerRadius="10" Background="White">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Foreground="#1F618D" Text="WLAN 링크 상태" />
            <TextBlock Margin="0,10,0,0" FontSize="18" FontWeight="SemiBold" Text="Native WLAN API" />
            <TextBlock Margin="0,8,0,0" Foreground="#707B7C" TextWrapping="Wrap"
                       Text="SSID, BSSID, RSSI, 채널, 주파수, PHY 및 Rx/Tx 링크 속도" />
            <Button Width="170"
                    Margin="0,14,0,0"
                    Padding="10,7"
                    HorizontalAlignment="Left"
                    Click="OnReadWlanStatusClick"
                    Content="현재 WLAN 확인" />
            <TextBlock x:Name="WlanResultText"
                       Margin="0,12,0,0"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="아직 확인하지 않았습니다." />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Padding="18" CornerRadius="10" Background="White">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Foreground="#117864" Text="내부망 다운로드" />
            <TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="M3 예정" />
            <TextBlock Margin="0,8,0,0" Foreground="#707B7C" TextWrapping="Wrap"
                       Text="DIRECT 또는 프록시 바이패스 경로 확인" />
          </StackPanel>
        </Border>

        <Border Grid.Column="4" Padding="18" CornerRadius="10" Background="White">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Foreground="#884EA0" Text="외부망 다운로드" />
            <TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="M4 예정" />
            <TextBlock Margin="0,8,0,0" Foreground="#707B7C" TextWrapping="Wrap"
                       Text="회사 프록시를 포함한 외부 서비스 체감 속도" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="3"
              Margin="0,18,0,0"
              Padding="20"
              CornerRadius="10"
              Background="White">
        <StackPanel>
          <TextBlock FontSize="18"
                     FontWeight="SemiBold"
                     Text="현재 사용자 프록시 설정 확인" />
          <TextBlock Margin="0,8,0,0"
                     Foreground="#566573"
                     TextWrapping="Wrap"
                     Text="프록시 주소와 PAC URL은 기본적으로 표시하지 않고 설정 여부만 확인합니다. 네트워크 요청은 발생하지 않습니다." />
          <Button Width="230"
                  Margin="0,16,0,0"
                  Padding="12,8"
                  HorizontalAlignment="Left"
                  Click="OnReadProxySettingsClick"
                  Content="로컬 프록시 설정 확인" />
          <TextBlock x:Name="ProxyResultText"
                     Margin="0,14,0,0"
                     FontFamily="Consolas"
                     TextWrapping="Wrap"
                     Text="아직 확인하지 않았습니다." />
        </StackPanel>
      </Border>

      <TextBlock Grid.Row="4"
                 Margin="0,20,0,0"
                 VerticalAlignment="Bottom"
                 Foreground="#7B7D7D"
                 TextWrapping="Wrap"
                 Text="AI·텔레메트리·자동 업데이트·결과 업로드 없음 · 외부 측정은 사용자가 실행한 HEAD/GET만 허용" />
    </Grid>
  </ScrollViewer>
</Window>
