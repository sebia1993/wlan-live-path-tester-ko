<Window x:Class="WlanLivePathTester.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WLAN Live Path Tester KO"
        Width="1040"
        Height="900"
        MinWidth="860"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="#17202A"
                   Text="WLAN Live Path Tester KO" />
        <TextBlock Margin="0,8,0,0"
                   FontSize="14"
                   Foreground="#566573"
                   Text="무선 링크·내부망·회사 프록시 경유 외부망을 분리해 확인하는 로컬 진단 도구" />
      </StackPanel>

      <Border Grid.Row="1"
              Margin="0,22,0,0"
              Padding="16"
              CornerRadius="10"
              Background="#EAF2F8"
              BorderBrush="#5DADE2"
              BorderThickness="1">
        <TextBlock Foreground="#1B4F72"
                   TextWrapping="Wrap">
          현재 버전은 M2 프록시 경로 판정 단계입니다. 프로그램 시작만으로 외부 통신을 만들지 않으며,
          PAC/WPAD 조회는 사용자가 대상 URL의 경로 확인 버튼을 눌렀을 때만 수행됩니다.
        </TextBlock>
      </Border>

      <Grid Grid.Row="2" Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.35*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="18" CornerRadius="10" Background="White">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Foreground="#1F618D" Text="WLAN 링크 상태" />
            <TextBlock Margin="0,10,0,0" FontSize="18" FontWeight="SemiBold" Text="Native WLAN API" />
            <TextBlock Margin="0,8,0,0" Foreground="#707B7C" TextWrapping="Wrap"
                       Text="SSID, BSSID, RSSI, 채널, 주파수, PHY 및 Rx/Tx 링크 속도" />
            <Button Width="170"
                    Margin="0,14,0,0"
                    Padding="10,7"
                    HorizontalAlignment="Left"
                    Click="OnReadWlanStatusClick"
                    Content="현재 WLAN 확인" />
            <TextBlock x:Name="WlanResultText"
                       Margin="0,12,0,0"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="아직 확인하지 않았습니다." />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Padding="18" CornerRadius="10" Background="White">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Foreground="#117864" Text="내부망 다운로드" />
            <TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="M3 예정" />
            <TextBlock Margin="0,8,0,0" Foreground="#707B7C" TextWrapping="Wrap"
                       Text="DIRECT 또는 프록시 바이패스 경로 확인" />
          </StackPanel>
        </Border>

        <Border Grid.Column="4" Padding="18" CornerRadius="10" Background="White">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Foreground="#884EA0" Text="외부망 다운로드" />
            <TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="M4 예정" />
            <TextBlock Margin="0,8,0,0" Foreground="#707B7C" TextWrapping="Wrap"
                       Text="회사 프록시를 포함한 외부 서비스 체감 속도" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Grid.Row="3" Margin="0,18,0,0">
        <Border Padding="20"
                CornerRadius="10"
                Background="White">
          <StackPanel>
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Text="현재 사용자 프록시 설정 확인" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="#566573"
                       TextWrapping="Wrap"
                       Text="프록시 주소와 PAC URL은 표시하지 않고 설정 여부만 확인합니다. 이 기능은 로컬 Windows 설정만 읽으며 네트워크 요청을 만들지 않습니다." />
            <Button Width="230"
                    Margin="0,16,0,0"
                    Padding="12,8"
                    HorizontalAlignment="Left"
                    Click="OnReadProxySettingsClick"
                    Content="로컬 프록시 설정 확인" />
            <TextBlock x:Name="ProxyResultText"
                       Margin="0,14,0,0"
                       FontFamily="Consolas"
                       TextWrapping="Wrap"
                       Text="아직 확인하지 않았습니다." />
          </StackPanel>
        </Border>

        <Border Margin="0,16,0,0"
                Padding="20"
                CornerRadius="10"
                Background="White">
          <StackPanel>
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Text="대상 URL별 프록시 경로 확인" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="#566573"
                       TextWrapping="Wrap"
                       Text="현재 로그인 사용자의 수동 프록시, 바이패스, WPAD 및 PAC 정책을 사용해 이 URL이 PROXY 또는 DIRECT인지 확인합니다." />

            <Border Margin="0,12,0,0"
                    Padding="12"
                    CornerRadius="7"
                    Background="#FFF8E1"
                    BorderBrush="#F4D03F"
                    BorderThickness="1">
              <TextBlock Foreground="#7D6608"
                         TextWrapping="Wrap"
                         Text="버튼을 누르면 PAC/WPAD가 설정된 환경에서 회사 내부 PAC 파일 조회, WPAD 탐색 또는 PAC 스크립트의 DNS 확인이 발생할 수 있습니다. 대상 사이트의 파일 본문은 다운로드하지 않습니다." />
            </Border>

            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock FontWeight="SemiBold" Text="확인할 HTTP/HTTPS URL" />
                <TextBox x:Name="ProxyTargetUrlTextBox"
                         Margin="0,6,0,0"
                         Padding="10,7"
                         ToolTip="예: https://example.invalid/path/file.bin" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock FontWeight="SemiBold" Text="예상 경로" />
                <ComboBox x:Name="ProxyExpectedPathComboBox"
                          Margin="0,6,0,0"
                          Padding="8,5"
                          SelectedIndex="0">
                  <ComboBoxItem Content="외부망 대상 — PROXY 예상" />
                  <ComboBoxItem Content="내부망 대상 — DIRECT 예상" />
                </ComboBox>
              </StackPanel>
            </Grid>

            <Button x:Name="ResolveProxyRouteButton"
                    Width="230"
                    Margin="0,16,0,0"
                    Padding="12,8"
                    HorizontalAlignment="Left"
                    Click="OnResolveProxyRouteClick"
                    Content="이 URL의 프록시 경로 확인" />

            <TextBlock x:Name="ProxyRouteResultText"
                       Margin="0,14,0,0"
                       FontFamily="Consolas"
                       TextWrapping="Wrap"
                       Text="아직 확인하지 않았습니다." />
          </StackPanel>
        </Border>
      </StackPanel>

      <TextBlock Grid.Row="4"
                 Margin="0,20,0,0"
                 VerticalAlignment="Bottom"
                 Foreground="#7B7D7D"
                 TextWrapping="Wrap"
                 Text="AI·텔레메트리·자동 업데이트·결과 업로드 없음 · 외부 측정은 사용자가 실행한 HEAD/GET만 허용" />
    </Grid>
  </ScrollViewer>
</Window>
