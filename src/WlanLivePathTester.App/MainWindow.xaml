<Window x:Class="WlanLivePathTester.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WLAN Live Path Tester KO"
        Width="1120"
        Height="900"
        MinWidth="900"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock FontSize="28"
                 FontWeight="SemiBold"
                 Foreground="#17202A"
                 Text="WLAN Live Path Tester KO" />
      <TextBlock Margin="0,7,0,0"
                 FontSize="14"
                 Foreground="#566573"
                 Text="무선 링크·내부망 DIRECT·회사 프록시 경유 외부망을 분리하는 Windows 로컬 진단 도구" />
    </StackPanel>

    <Border Grid.Row="1"
            Margin="0,18,0,0"
            Padding="14"
            CornerRadius="9"
            Background="#EAF2F8"
            BorderBrush="#5DADE2"
            BorderThickness="1">
      <TextBlock Foreground="#1B4F72"
                 TextWrapping="Wrap"
                 Text="M3·M4 다운로드 측정 단계 · 프로그램 시작만으로 네트워크 요청을 만들지 않습니다. PAC/WPAD 확인과 HEAD/GET 다운로드는 사용자가 해당 버튼을 눌렀을 때만 실행됩니다." />
    </Border>

    <TabControl Grid.Row="2" Margin="0,18,0,0">
      <TabItem Header="WLAN · 프록시">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0"
                      Padding="18"
                      CornerRadius="9"
                      Background="White">
                <StackPanel>
                  <TextBlock FontSize="18"
                             FontWeight="SemiBold"
                             Foreground="#1F618D"
                             Text="현재 WLAN 링크 상태" />
                  <TextBlock Margin="0,7,0,0"
                             Foreground="#707B7C"
                             TextWrapping="Wrap"
                             Text="Native WLAN API로 SSID, BSSID, RSSI, 채널, PHY와 Rx/Tx 링크 속도를 읽습니다. 외부 통신은 없습니다." />
                  <Button Width="170"
                          Margin="0,14,0,0"
                          Padding="10,7"
                          HorizontalAlignment="Left"
                          Click="OnReadWlanStatusClick"
                          Content="현재 WLAN 확인" />
                  <TextBlock x:Name="WlanResultText"
                             Margin="0,12,0,0"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Text="아직 확인하지 않았습니다." />
                </StackPanel>
              </Border>

              <Border Grid.Column="2"
                      Padding="18"
                      CornerRadius="9"
                      Background="White">
                <StackPanel>
                  <TextBlock FontSize="18"
                             FontWeight="SemiBold"
                             Foreground="#117864"
                             Text="현재 사용자 프록시 설정" />
                  <TextBlock Margin="0,7,0,0"
                             Foreground="#707B7C"
                             TextWrapping="Wrap"
                             Text="로컬 Windows 설정만 읽습니다. 프록시 주소, 바이패스 목록과 PAC URL 원문은 표시하지 않습니다." />
                  <Button Width="210"
                          Margin="0,14,0,0"
                          Padding="10,7"
                          HorizontalAlignment="Left"
                          Click="OnReadProxySettingsClick"
                          Content="로컬 프록시 설정 확인" />
                  <TextBlock x:Name="ProxyResultText"
                             Margin="0,12,0,0"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Text="아직 확인하지 않았습니다." />
                </StackPanel>
              </Border>
            </Grid>

            <Border Margin="0,16,0,0"
                    Padding="18"
                    CornerRadius="9"
                    Background="White">
              <StackPanel>
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Text="대상 URL별 프록시 경로 확인" />
                <TextBlock Margin="0,7,0,0"
                           Foreground="#566573"
                           TextWrapping="Wrap"
                           Text="현재 사용자의 수동 프록시, 바이패스, WPAD 및 PAC 정책으로 해당 URL이 PROXY 또는 DIRECT인지 확인합니다." />

                <Border Margin="0,11,0,0"
                        Padding="11"
                        CornerRadius="7"
                        Background="#FFF8E1"
                        BorderBrush="#F4D03F"
                        BorderThickness="1">
                  <TextBlock Foreground="#7D6608"
                             TextWrapping="Wrap"
                             Text="PAC/WPAD 환경에서는 회사 내부 PAC 파일 조회, WPAD 탐색 또는 PAC 스크립트의 DNS 확인이 발생할 수 있습니다. 이 버튼은 대상 사이트 본문을 다운로드하지 않습니다." />
                </Border>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="확인할 HTTP/HTTPS URL" />
                    <TextBox x:Name="ProxyTargetUrlTextBox"
                             Margin="0,6,0,0"
                             Padding="10,7"
                             ToolTip="예: https://example.invalid/path/file.bin" />
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="예상 경로" />
                    <ComboBox x:Name="ProxyExpectedPathComboBox"
                              Margin="0,6,0,0"
                              Padding="8,5"
                              SelectedIndex="0">
                      <ComboBoxItem Content="외부망 대상 — PROXY 예상" />
                      <ComboBoxItem Content="내부망 대상 — DIRECT 예상" />
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <Button x:Name="ResolveProxyRouteButton"
                        Width="230"
                        Margin="0,14,0,0"
                        Padding="12,8"
                        HorizontalAlignment="Left"
                        Click="OnResolveProxyRouteClick"
                        Content="이 URL의 프록시 경로 확인" />

                <TextBlock x:Name="ProxyRouteResultText"
                           Margin="0,12,0,0"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="아직 확인하지 않았습니다." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="내부 · 외부 다운로드 측정">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18">
            <Border Padding="13"
                    CornerRadius="8"
                    Background="#FDEDEC"
                    BorderBrush="#EC7063"
                    BorderThickness="1">
              <TextBlock Foreground="#922B21"
                         TextWrapping="Wrap"
                         Text="측정 시작 버튼은 실제 HEAD/GET 네트워크 요청을 만듭니다. 다운로드 본문은 파일로 저장하지 않고 고정 버퍼에서 즉시 폐기합니다. 외부 업로드, POST, PUT, PATCH, DELETE는 수행하지 않습니다." />
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="16"
                    CornerRadius="9"
                    Background="White">
              <StackPanel>
                <TextBlock FontSize="17"
                           FontWeight="SemiBold"
                           Text="공통 측정 설정" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="#707B7C"
                           Text="외부 URL을 여러 개 입력한 경우 각 대상에 아래 최대 수신량을 개별 적용합니다." />

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.2*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="최대 수신량(MB)" />
                    <TextBox x:Name="MeasurementMaxMegabytesTextBox"
                             Margin="0,5,0,0"
                             Padding="8,5"
                             Text="100" />
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="제한 시간(초)" />
                    <TextBox x:Name="MeasurementTimeoutSecondsTextBox"
                             Margin="0,5,0,0"
                             Padding="8,5"
                             Text="30" />
                  </StackPanel>

                  <StackPanel Grid.Column="4">
                    <TextBlock FontWeight="SemiBold" Text="스트림 수" />
                    <ComboBox x:Name="MeasurementStreamsComboBox"
                              Margin="0,5,0,0"
                              Padding="7,4"
                              SelectedIndex="0">
                      <ComboBoxItem Content="1" />
                      <ComboBoxItem Content="2" />
                      <ComboBoxItem Content="3" />
                      <ComboBoxItem Content="4" />
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Grid.Column="6">
                    <TextBlock FontWeight="SemiBold" Text="최대 리다이렉트" />
                    <TextBox x:Name="MeasurementMaxRedirectsTextBox"
                             Margin="0,5,0,0"
                             Padding="8,5"
                             Text="5" />
                  </StackPanel>

                  <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                    <CheckBox x:Name="MeasurementHeadPreflightCheckBox"
                              IsChecked="True"
                              Content="HEAD 사전검사 사용" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="#7B7D7D"
                               TextWrapping="Wrap"
                               Text="HEAD 미지원(405/501)은 GET으로 계속합니다." />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0"
                      Padding="16"
                      CornerRadius="9"
                      Background="White">
                <StackPanel>
                  <TextBlock FontSize="18"
                             FontWeight="SemiBold"
                             Foreground="#117864"
                             Text="내부망 DIRECT 측정" />
                  <TextBlock Margin="0,6,0,0"
                             Foreground="#707B7C"
                             TextWrapping="Wrap"
                             Text="사내 유선 기준 서버의 승인된 고정 파일 URL을 입력합니다. 프록시 경유로 판정되면 요청 전 차단합니다." />
                  <TextBlock Margin="0,11,0,0"
                             FontWeight="SemiBold"
                             Text="내부 HTTP/HTTPS URL" />
                  <TextBox x:Name="InternalTargetUrlTextBox"
                           Margin="0,5,0,0"
                           Padding="9,6"
                           ToolTip="예: http://내부서버/network-test/100mb.bin" />
                  <Button x:Name="StartInternalMeasurementButton"
                          Width="190"
                          Margin="0,13,0,0"
                          Padding="11,7"
                          HorizontalAlignment="Left"
                          Click="OnStartInternalMeasurementClick"
                          Content="내부망 측정 시작" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2"
                      Padding="16"
                      CornerRadius="9"
                      Background="White">
                <StackPanel>
                  <TextBlock FontSize="18"
                             FontWeight="SemiBold"
                             Foreground="#884EA0"
                             Text="외부망 프록시 경유 측정" />
                  <TextBlock Margin="0,6,0,0"
                             Foreground="#707B7C"
                             TextWrapping="Wrap"
                             Text="서로 다른 승인 외부 파일 URL을 한 줄에 하나씩 최대 4개 입력합니다. 결과는 회사 프록시를 포함한 외부 서비스 체감 속도입니다." />
                  <TextBlock Margin="0,11,0,0"
                             FontWeight="SemiBold"
                             Text="외부 HTTP/HTTPS URL — 한 줄에 하나" />
                  <TextBox x:Name="ExternalTargetUrlsTextBox"
                           Height="78"
                           Margin="0,5,0,0"
                           Padding="9,6"
                           AcceptsReturn="True"
                           VerticalScrollBarVisibility="Auto"
                           TextWrapping="NoWrap"
                           ToolTip="서로 다른 외부 대상 URL을 최대 4줄 입력" />
                  <Button x:Name="StartExternalMeasurementButton"
                          Width="210"
                          Margin="0,13,0,0"
                          Padding="11,7"
                          HorizontalAlignment="Left"
                          Click="OnStartExternalMeasurementClick"
                          Content="외부망 대상 순차 측정" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Margin="0,14,0,0"
                    Padding="14"
                    CornerRadius="9"
                    Background="White">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MeasurementStatusText"
                           VerticalAlignment="Center"
                           Foreground="#566573"
                           TextWrapping="Wrap"
                           Text="측정 대기 중" />
                <Button x:Name="CancelMeasurementButton"
                        Grid.Column="1"
                        Width="130"
                        Margin="14,0,0,0"
                        Padding="10,6"
                        IsEnabled="False"
                        Click="OnCancelMeasurementClick"
                        Content="측정 취소" />
              </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0"
                      Padding="16"
                      CornerRadius="9"
                      Background="White">
                <StackPanel>
                  <TextBlock FontSize="16"
                             FontWeight="SemiBold"
                             Text="내부망 측정 결과" />
                  <TextBlock x:Name="InternalMeasurementResultText"
                             Margin="0,10,0,0"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Text="아직 측정하지 않았습니다." />
                </StackPanel>
              </Border>

              <Border Grid.Column="2"
                      Padding="16"
                      CornerRadius="9"
                      Background="White">
                <StackPanel>
                  <TextBlock FontSize="16"
                             FontWeight="SemiBold"
                             Text="외부망 대상별 결과" />
                  <TextBlock x:Name="ExternalMeasurementResultText"
                             Margin="0,10,0,0"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Text="아직 측정하지 않았습니다." />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="3"
               Margin="0,12,0,0"
               Foreground="#7B7D7D"
               TextWrapping="Wrap"
               Text="AI·텔레메트리·자동 업데이트·결과 업로드 없음 · 외부 통신은 사용자 실행 HEAD/GET만 허용 · 실제 환경 검증은 로컬에서 수행" />
  </Grid>
</Window>
