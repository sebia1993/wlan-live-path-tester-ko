<Window x:Class="WlanLivePathTester.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WLAN Live Path Tester KO"
        Width="1280"
        Height="900"
        FontSize="13"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
  <Grid Margin="20" Background="#F4F6F8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.ColumnSpan="2">
      <TextBlock FontSize="28"
                 FontWeight="SemiBold"
                 Foreground="#17202A"
                 Text="WLAN Live Path Tester KO" />
      <TextBlock Margin="0,7,0,0"
                 FontSize="14"
                 Foreground="#566573"
                 Text="무선 연결부터 서비스 성능까지, 근거를 따라 점검합니다" />
    </StackPanel>

    <Border Grid.Row="1" Grid.Column="1" Margin="12,16,0,10" Padding="14"
            Background="#EAF2F8" CornerRadius="8">
      <StackPanel>
        <TextBlock x:Name="GuidedTitle" FontSize="19" FontWeight="SemiBold" />
        <TextBlock x:Name="GuidedQuestion" Margin="0,6,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="GuidedLimitation" Margin="0,6,0,0" Foreground="#566573" TextWrapping="Wrap" />
        <TextBlock x:Name="GuidedNextAction" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />
        <WrapPanel x:Name="GuidedChoices" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="1" Grid.RowSpan="2" Margin="0,16,12,0">
      <TextBlock Text="어떤 문제가 있나요?" FontWeight="SemiBold" Margin="0,0,0,6" />
      <ComboBox x:Name="GuidedSymptom" SelectionChanged="OnGuidedSymptomChanged" Margin="0,0,0,12" Padding="5" AutomationProperties.Name="장애 증상 선택">
        <ComboBoxItem Content="증상을 선택하세요" />
        <ComboBoxItem Content="Wi-Fi 연결이 안 됨" />
        <ComboBoxItem Content="연결됐지만 인터넷 안 됨" />
        <ComboBoxItem Content="연결은 되지만 느림" />
        <ComboBoxItem Content="자주 끊김" />
      </ComboBox>
      <TextBlock Text="무선 진단 순서" FontWeight="SemiBold" Margin="0,0,0,10" />
      <StackPanel x:Name="GuidedSteps">
        <Button Content="① 무선 연결 · L1/L2" Tag="0" Click="OnGuidedStepClick" Padding="10,12" Margin="0,0,0,7" HorizontalContentAlignment="Left" />
        <Button Content="② IP·실제 경로 · L3" Tag="1" Click="OnGuidedStepClick" Padding="10,12" Margin="0,0,0,7" HorizontalContentAlignment="Left" />
        <Button Content="③ 프록시·서비스 확인" Tag="2" Click="OnGuidedStepClick" Padding="10,12" Margin="0,0,0,7" HorizontalContentAlignment="Left" />
        <Button Content="④ 성능 비교" Tag="3" Click="OnGuidedStepClick" Padding="10,12" Margin="0,0,0,7" HorizontalContentAlignment="Left" />
        <Button Content="⑤ 결과·보고서" Tag="4" Click="OnGuidedStepClick" Padding="10,12" Margin="0,0,0,7" HorizontalContentAlignment="Left" />
      </StackPanel>
      <TextBlock Text="번호는 점검 순서입니다. 다른 단계로 이동해도 검사는 자동 실행되지 않습니다." TextWrapping="Wrap" Foreground="#566573" Margin="0,12,0,16" />
      <CheckBox x:Name="GuidedAdvanced" Content="고급: 전체 도구 보기" Checked="OnGuidedAdvancedChanged" Unchecked="OnGuidedAdvancedChanged" />
      <ComboBox x:Name="GuidedAdvancedTools" Visibility="Collapsed" Margin="0,10,0,0" SelectionChanged="OnGuidedToolChanged" AutomationProperties.Name="전체 진단 도구" />
      <TextBlock Text="외부 측정과 PAC/WPAD 조회는 해당 실행 버튼을 누를 때만 시작합니다." TextWrapping="Wrap" Foreground="#566573" Margin="0,16,0,0" />
    </StackPanel>
    <TabControl x:Name="DiagnosticTabs" Grid.Row="2" Grid.Column="1" Margin="12,0,0,0">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
        </ControlTemplate>
      </TabControl.Template>
      <TabItem Header="WLAN · 프록시">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18">
            <Grid x:Name="BasicDiagnosticPanels">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border x:Name="GuidedWlanPanel" Grid.Column="0"
                      Padding="18"
                      CornerRadius="9"
                      Background="White">
                <StackPanel>
                  <TextBlock FontSize="18"
                             FontWeight="SemiBold"
                             Foreground="#1F618D"
                             Text="현재 WLAN 링크 상태" />
                  <TextBlock Margin="0,7,0,0"
                             Foreground="#707B7C"
                             TextWrapping="Wrap"
                             Text="연결된 Wi-Fi 이름과 AP, 신호 세기, 채널, 링크 속도를 확인합니다. 외부 사이트에는 접속하지 않습니다." />
                  <Button Width="170"
                          Margin="0,14,0,0"
                          Padding="10,7"
                          HorizontalAlignment="Left"
                          Click="OnReadWlanStatusClick"
                          Content="무선 진단 시작" />
                  <TextBlock x:Name="WlanResultText"
                             Margin="0,12,0,0"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Text="아직 확인하지 않았습니다." />
                </StackPanel>
              </Border>

              <Border x:Name="GuidedProxyPanel" Grid.Column="2"
                      Padding="18"
                      CornerRadius="9"
                      Background="White">
                <StackPanel>
                  <TextBlock FontSize="18"
                             FontWeight="SemiBold"
                             Foreground="#117864"
                             Text="현재 사용자 프록시 설정" />
                  <TextBlock Margin="0,7,0,0"
                             Foreground="#707B7C"
                             TextWrapping="Wrap"
                             Text="로컬 Windows 설정만 읽습니다. 프록시 주소, 바이패스 목록과 PAC URL 원문은 표시하지 않습니다." />
                  <Button Width="210"
                          Margin="0,14,0,0"
                          Padding="10,7"
                          HorizontalAlignment="Left"
                          Click="OnReadProxySettingsClick"
                          Content="로컬 프록시 설정 확인" />
                  <TextBlock x:Name="ProxyResultText"
                             Margin="0,12,0,0"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Text="아직 확인하지 않았습니다." />
                </StackPanel>
              </Border>
            </Grid>

            <Border x:Name="GuidedProxyRoutePanel" Margin="0,16,0,0"
                    Padding="18"
                    CornerRadius="9"
                    Background="White">
              <StackPanel>
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Text="대상 URL별 프록시 경로 확인" />
                <TextBlock Margin="0,7,0,0"
                           Foreground="#566573"
                           TextWrapping="Wrap"
                           Text="현재 사용자의 수동 프록시, 바이패스, WPAD 및 PAC 정책으로 해당 URL이 PROXY 또는 DIRECT인지 확인합니다." />

                <Border Margin="0,11,0,0"
                        Padding="11"
                        CornerRadius="7"
                        Background="#FFF8E1"
                        BorderBrush="#F4D03F"
                        BorderThickness="1">
                  <TextBlock Foreground="#7D6608"
                             TextWrapping="Wrap"
                             Text="PAC/WPAD 환경에서는 회사 내부 PAC 파일 조회, WPAD 탐색 또는 PAC 스크립트의 DNS 확인이 발생할 수 있습니다. 이 버튼은 대상 사이트 본문을 다운로드하지 않습니다." />
                </Border>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="확인할 HTTP/HTTPS URL" />
                    <TextBox x:Name="ProxyTargetUrlTextBox"
                             Margin="0,6,0,0"
                             Padding="10,7"
                             ToolTip="예: https://example.invalid/path/file.bin" />
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="예상 경로" />
                    <ComboBox x:Name="ProxyExpectedPathComboBox"
                              Margin="0,6,0,0"
                              Padding="8,5"
                              SelectedIndex="0">
                      <ComboBoxItem Content="외부망 대상 — PROXY 예상" />
                      <ComboBoxItem Content="내부망 대상 — DIRECT 예상" />
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <Button x:Name="ResolveProxyRouteButton"
                        Width="230"
                        Margin="0,14,0,0"
                        Padding="12,8"
                        HorizontalAlignment="Left"
                        Click="OnResolveProxyRouteClick"
                        Content="이 URL의 프록시 경로 확인" />

                <TextBlock x:Name="ProxyRouteResultText"
                           Margin="0,12,0,0"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="아직 확인하지 않았습니다." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="내부 · 외부 다운로드 측정">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18">
            <Border Padding="13"
                    CornerRadius="8"
                    Background="#EAF2F8"
                    BorderBrush="#AED6F1"
                    BorderThickness="1">
              <TextBlock Foreground="#1F618D"
                         TextWrapping="Wrap"
                         Text="시작 버튼을 누르면 지정한 파일을 내려받아 속도를 측정합니다. 수신 데이터는 저장하지 않습니다. 회사에서 승인한 측정 대상만 사용하세요." />
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="16"
                    CornerRadius="9"
                    Background="White">
              <Expander x:Name="MeasurementAdvancedSettings" Header="고급 측정 설정 · 기본값으로 시작할 수 있습니다" IsExpanded="False">
<StackPanel>
                <TextBlock FontSize="17"
                           FontWeight="SemiBold"
                           Text="공통 측정 설정" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="#707B7C"
                           Text="외부 URL을 여러 개 입력한 경우 각 대상에 아래 최대 수신량을 개별 적용합니다." />

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.2*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="최대 수신량(MB)" />
                    <TextBox x:Name="MeasurementMaxMegabytesTextBox"
                             Margin="0,5,0,0"
                             Padding="8,5"
                             Text="100" />
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="제한 시간(초)" />
                    <TextBox x:Name="MeasurementTimeoutSecondsTextBox"
                             Margin="0,5,0,0"
                             Padding="8,5"
                             Text="30" />
                  </StackPanel>

                  <StackPanel Grid.Column="4">
                    <TextBlock FontWeight="SemiBold" Text="스트림 수" />
                    <ComboBox x:Name="MeasurementStreamsComboBox"
                              Margin="0,5,0,0"
                              Padding="7,4"
                              SelectedIndex="0">
                      <ComboBoxItem Content="1" />
                      <ComboBoxItem Content="2" />
                      <ComboBoxItem Content="3" />
                      <ComboBoxItem Content="4" />
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Grid.Column="6">
                    <TextBlock FontWeight="SemiBold" Text="최대 리다이렉트" />
                    <TextBox x:Name="MeasurementMaxRedirectsTextBox"
                             Margin="0,5,0,0"
                             Padding="8,5"
                             Text="5" />
                  </StackPanel>

                  <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                    <CheckBox x:Name="MeasurementHeadPreflightCheckBox"
                              IsChecked="True"
                              Content="HEAD 사전검사 사용" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="#7B7D7D"
                               TextWrapping="Wrap"
                               Text="HEAD 미지원(405/501)은 GET으로 계속합니다." />
                  </StackPanel>
                </Grid>
              </StackPanel>
              </Expander>
            </Border>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0"
                      Padding="16"
                      CornerRadius="9"
                      Background="White">
                <StackPanel>
                  <TextBlock FontSize="18"
                             FontWeight="SemiBold"
                             Foreground="#117864"
                             Text="내부망 DIRECT 측정" />
                  <TextBlock Margin="0,6,0,0"
                             Foreground="#707B7C"
                             TextWrapping="Wrap"
                             Text="사내 유선 기준 서버의 승인된 고정 파일 URL을 입력합니다. 프록시 경유로 판정되면 요청 전 차단합니다." />
                  <TextBlock Margin="0,11,0,0"
                             FontWeight="SemiBold"
                             Text="내부 HTTP/HTTPS URL" />
                  <TextBox x:Name="InternalTargetUrlTextBox"
                           Margin="0,5,0,0"
                           Padding="9,6"
                           ToolTip="예: http://내부서버/network-test/100mb.bin" />
                  <Button x:Name="StartInternalMeasurementButton"
                          Width="190"
                          Margin="0,13,0,0"
                          Padding="11,7"
                          HorizontalAlignment="Left"
                          Click="OnStartInternalMeasurementClick"
                          Content="내부망 측정 시작" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2"
                      Padding="16"
                      CornerRadius="9"
                      Background="White">
                <StackPanel>
                  <TextBlock FontSize="18"
                             FontWeight="SemiBold"
                             Foreground="#884EA0"
                             Text="외부망 프록시 경유 측정" />
                  <TextBlock Margin="0,6,0,0"
                             Foreground="#707B7C"
                             TextWrapping="Wrap"
                             Text="서로 다른 승인 외부 파일 URL을 한 줄에 하나씩 최대 4개 입력합니다. 결과는 회사 프록시를 포함한 외부 서비스 체감 속도입니다." />
                  <TextBlock Margin="0,11,0,0"
                             FontWeight="SemiBold"
                             Text="외부 HTTP/HTTPS URL — 한 줄에 하나" />
                  <TextBox x:Name="ExternalTargetUrlsTextBox"
                           Height="78"
                           Margin="0,5,0,0"
                           Padding="9,6"
                           AcceptsReturn="True"
                           VerticalScrollBarVisibility="Auto"
                           TextWrapping="NoWrap"
                           ToolTip="서로 다른 외부 대상 URL을 최대 4줄 입력" />
                  <Button x:Name="StartExternalMeasurementButton"
                          Width="210"
                          Margin="0,13,0,0"
                          Padding="11,7"
                          HorizontalAlignment="Left"
                          Click="OnStartExternalMeasurementClick"
                          Content="외부망 대상 순차 측정" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Margin="0,14,0,0"
                    Padding="14"
                    CornerRadius="9"
                    Background="White">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MeasurementStatusText"
                           VerticalAlignment="Center"
                           Foreground="#566573"
                           TextWrapping="Wrap"
                           Text="측정 대기 중" />
                <Button x:Name="CancelMeasurementButton"
                        Grid.Column="1"
                        Width="130"
                        Margin="14,0,0,0"
                        Padding="10,6"
                        IsEnabled="False"
                        Click="OnCancelMeasurementClick"
                        Content="측정 취소" />
              </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0"
                      Padding="16"
                      CornerRadius="9"
                      Background="White">
                <StackPanel>
                  <TextBlock FontSize="16"
                             FontWeight="SemiBold"
                             Text="내부망 측정 결과" />
                  <TextBlock x:Name="InternalMeasurementResultText"
                             Margin="0,10,0,0"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Text="아직 측정하지 않았습니다." />
                </StackPanel>
              </Border>

              <Border Grid.Column="2"
                      Padding="16"
                      CornerRadius="9"
                      Background="White">
                <StackPanel>
                  <TextBlock FontSize="16"
                             FontWeight="SemiBold"
                             Text="외부망 대상별 결과" />
                  <TextBlock x:Name="ExternalMeasurementResultText"
                             Margin="0,10,0,0"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Text="아직 측정하지 않았습니다." />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
               Margin="0,12,0,0"
               Foreground="#7B7D7D"
               TextWrapping="Wrap"
               Text="AI·텔레메트리·자동 업데이트·결과 업로드 없음 · 외부 통신은 사용자 실행 HEAD/GET만 허용 · 실제 환경 검증은 로컬에서 수행" />
  </Grid>
</Window>
